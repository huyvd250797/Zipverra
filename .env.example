# Production HTTPS origin. Must be an exact root URL and match the GitHub App callback.
APP_URL=https://your-zipverra-domain.vercel.app

# GitHub Settings > Developer settings > GitHub Apps > New GitHub App
# Client ID starts with Iv (e.g. Iv23... or legacy Iv1...); NOT App ID or OAuth App ID
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# GitHub App URL slug: github.com/apps/<this-slug>
GITHUB_APP_SLUG=

# Generate a cryptographically random 64-character hex secret (e.g. openssl rand -hex 32).
# Changing it signs everyone out. NEVER commit the real value.
SESSION_SECRET=

# Optional: needed only for ZIP entries >3 MB and <=20 MiB.
# Create a PRIVATE Vercel Blob store connected to the Zipverra project.
# Keep this secret on the server; do not use NEXT_PUBLIC_ prefix.
BLOB_READ_WRITE_TOKEN=

# Recommended: auth for daily cleanup of interrupted temporary private uploads.
# Set CRON_SECRET to a strong random string in Vercel Environment Variables.
CRON_SECRET=
