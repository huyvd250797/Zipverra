# Exact public origin. Must be HTTPS in production and match GitHub OAuth app callback.
# Example: https://zipverra.vercel.app
APP_URL=https://your-zipverra-domain.vercel.app

# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
# Minimum 32 random characters; never commit or expose it.
SESSION_SECRET=
